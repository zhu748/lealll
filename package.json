{
  "name": "zcode-proxy",
  "version": "0.3.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "ZCODE_PROXY_TEST_QUIET=1 bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --define \"require.resolve=undefined\" --target=bun-windows-x64 src/index.ts --outfile zcode-proxy.exe"
  },
  "dependencies": {
    "happy-dom": "^20.11.6",
    "undici": "^8.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.5.0"
  }
}
