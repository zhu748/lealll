# Auto-detect text files
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
*.yml text eol=lf

# Binary files
*.jar binary
*.so binary
*.png binary
# Batch file MUST keep CRLF bytes in the blob — CMD breaks if/goto on LF,
# and the release CI guards "file release/start.bat | grep CRLF" on checkout.
release/start.bat -text
